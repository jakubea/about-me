{
  "name": "elm-cv-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm clean && vite --host",
    "dev:nodebug": "cross-env ELM_DEBUGGER=false pnpm dev",
    "build": "vite build",
    "preview": "vite preview",
    "localazy:download": "pnpm localazy:only-download && pnpm format:prettier",
    "localazy:only-download": "localazy download",
    "localazy:upload": "localazy upload --project about-me",
    "localazy:upload-existing": "localazy upload existing",
    "make": "elm make",
    "test": "elm-test \"tests/**/*Tests.elm\"",
    "review": "elm-review",
    "format": "pnpm format:elm-format && pnpm format:prettier",
    "format:elm-format": "elm-format --yes ./src/ ./tests/ ./review/",
    "format:prettier": "prettier --write \"{config,scripts,src}/**/*.{js,json}\" README.md",
    "precommit": "pnpm format && pnpm test && pnpm review",
    "clean": "rimraf elm-stuff dist",
    "elm:outdated": "elm-outdated",
    "elm:install": "node --version"
  },
  "devDependencies": {
    "@localazy/cli": "1.7.14",
    "elm": "0.19.1-6",
    "elm-test": "^0.19.1-revision12",
    "elm-format": "^0.8.7",
    "elm-review": "^2.13.5",
    "elm-outdated": "^1.1.1",
    "vite": "^5.4.14",
    "vite-plugin-elm": "^3.0.1",
    "prettier": "3.3.3",
    "rimraf": "^6.0.1",
    "cross-env": "^7.0.3",
    "terser": "^5.37.0"
  }
}
